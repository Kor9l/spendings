# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Пароль базы
POSTGRES_PASSWORD=
# Ключ «Запомнить меня»: openssl rand -hex 32
SPENDINGS_REMEMBER_ME_KEY=

# Адрес, по которому открывают приложение. Passkeys привязаны к домену.
SPENDINGS_DOMAIN=money.example.com
SPENDINGS_RP_ID=money.example.com
SPENDINGS_ORIGIN=https://money.example.com
# Порт приложения слушает только localhost; 0.0.0.0 — доступ из локальной сети без HTTPS
#SPENDINGS_BIND=127.0.0.1

TZ=Europe/Minsk

# Бэкап: время, сколько дней хранить, куда класть на хосте
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=30
#BACKUP_DIR=./backups
# Копия вне сервера: команда получает путь к дампу в $BACKUP_FILE. Например, rclone в облако
# (rclone нужно добавить в образ) или scp на другой компьютер:
#BACKUP_COPY_COMMAND=scp -i /backups/.ssh/id_ed25519 "$BACKUP_FILE" backup@nas.local:spendings/
